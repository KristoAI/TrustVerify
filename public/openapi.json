{
  "openapi": "3.1.0",
  "info": {
    "title": "TrustBunny API",
    "version": "1.0.0",
    "description": "Browser-asserted age-check transport. Images, DOB, exact ages, and OCR text are not accepted. Use your configured TrustBunny origin as the server URL."
  },
  "servers": [
    {
      "url": "http://localhost:3300",
      "description": "Local development; replace for your deployment"
    }
  ],
  "components": {
    "securitySchemes": {
      "serverKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Site-scoped server API key. Never expose in browser JavaScript."
      }
    },
    "schemas": {
      "VerificationResult": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "site_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "created",
              "in_progress",
              "completed",
              "expired",
              "cancelled"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "not_passed",
              "inconclusive",
              null
            ]
          },
          "environment": {
            "enum": [
              "test",
              "live"
            ]
          },
          "age_over": {
            "type": "integer",
            "minimum": 18,
            "maximum": 99
          },
          "method": {
            "enum": [
              "selfie",
              "document",
              null
            ]
          },
          "assurance": {
            "const": "browser_asserted"
          },
          "source": {
            "enum": [
              "browser",
              "reused",
              null
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "serverKey": []
    }
  ],
  "paths": {
    "/v1/verification-sessions": {
      "post": {
        "summary": "Create a verification session",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "minLength": 22,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "response_mode": {
                    "enum": [
                      "assertion",
                      "code"
                    ],
                    "default": "assertion"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "verification_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "environment": {
                      "enum": [
                        "test",
                        "live"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/verification-sessions/{id}": {
      "get": {
        "summary": "Check the current result and validity",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current verification result",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/VerificationResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "delivery_status": {
                          "enum": [
                            "not_configured",
                            "pending",
                            "processing",
                            "delivered",
                            "failed"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Session not found for this site",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/result-exchanges": {
      "post": {
        "summary": "Exchange a one-time result code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "state"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 200
                  },
                  "state": {
                    "type": "string",
                    "minLength": 22,
                    "maxLength": 128,
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result and current validity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResult"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, consumed, or mismatched code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Code consumed concurrently",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "summary": "Public ES256 verification keys",
        "security": [],
        "responses": {
          "200": {
            "description": "JSON Web Key Set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
