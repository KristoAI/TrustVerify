{
  "name": "trustbunny",
  "version": "1.0.0",
  "description": "Privacy-focused browser age verification and reusable passes",
  "main": "server/index.mjs",
  "scripts": {
    "startDev": "node --watch server/index.mjs",
    "startProd": "node server/index.mjs",
    "build": "node script/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker": "node server/worker.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --project web/verification/tsconfig.json",
    "audit:core": "node script/audit-core.mjs",
    "package:core": "node script/package-core.mjs",
    "assets:fetch": "node script/fetch-verification-assets.mjs",
    "email:usage": "node script/email-usage.mjs"
  },
  "author": "GoDotCam",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/qrcode": "1.5.6",
    "esbuild": "^0.28.2",
    "jsqr": "1.4.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "cbor-x": "^1.6.6",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.2.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "qrcode": "1.5.4",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
