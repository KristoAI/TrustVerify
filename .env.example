HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=3300
# Production public origin: https://trustbunny.com
TV_ORIGIN=http://localhost:3300

# Server-only. Never prefix these with NEXT_PUBLIC_ or expose them in JavaScript.
TV_STORE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/trustverify-store
TV_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_JWT
TV_STORE_SECRET=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
TV_MASTER_KEY=GENERATE_ANOTHER_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS

# Optional trusted proxy IPs/CIDRs, comma-separated. Never trust arbitrary clients.
# TV_TRUST_PROXY=loopback

# Optional TEST-session email history + inbox experiment; never creates an age proof.
TV_EMAIL_EXPERIMENT=false
TV_EMAIL_HISTORY_YEARS=10
TV_EMAIL_EDGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/trustbunny-email
# Independent random secret shared only with the SES edge function (32+ characters).
TV_EMAIL_EDGE_SECRET=
# Edge-only secrets: TV_EMAIL_FROM, AWS_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, optional AWS_SESSION_TOKEN and TV_EMAIL_SES_CONFIGURATION_SET.
# Keep AWS credentials out of Node/browser environments; see docs/EMAIL_EXPERIMENT.md.
